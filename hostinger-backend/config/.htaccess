# ==============================================================================
# Mumtahina’s Closet Inc - Configuration Directory Protection
# Prohibits direct HTTP/browser access to configuration files and credentials
# ==============================================================================

<IfModule mod_authz_core.c>
    Require all denied
</IfModule>

<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
