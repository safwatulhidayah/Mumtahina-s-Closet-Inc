# ==============================================================================
# Mumtahina’s Closet Inc - Database Directory Protection
# Prohibits direct HTTP/browser access to schema and SQL files
# ==============================================================================

<IfModule mod_authz_core.c>
    Require all denied
</IfModule>

<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
