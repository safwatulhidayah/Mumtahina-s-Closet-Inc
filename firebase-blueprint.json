{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile information for clients of Mumtahina's Closet",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Firebase Auth UID of the user",
          "maxLength": 128
        },
        "name": {
          "type": "string",
          "description": "Full name of the client",
          "maxLength": 100
        },
        "email": {
          "type": "string",
          "description": "Email address of the client",
          "maxLength": 120
        },
        "phone": {
          "type": "string",
          "description": "Contact telephone number",
          "maxLength": 30
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp when the profile was created"
        },
        "updatedAt": {
          "type": "string",
          "description": "Timestamp when the profile was last modified"
        }
      },
      "required": ["id", "name", "email"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer purchase order records supporting future payment gateway integration",
      "type": "object",
      "properties": {
        "orderId": {
          "type": "string",
          "description": "Unique purchase order identifier",
          "maxLength": 64
        },
        "customerId": {
          "type": "string",
          "description": "Identifier or UID of the purchasing customer",
          "maxLength": 128
        },
        "customerName": {
          "type": "string",
          "description": "Full name of the purchasing customer",
          "maxLength": 100
        },
        "customerEmail": {
          "type": "string",
          "description": "Contact email address of the customer",
          "maxLength": 120
        },
        "customerPhone": {
          "type": "string",
          "description": "Customer contact telephone number",
          "maxLength": 30
        },
        "totalAmount": {
          "type": "number",
          "description": "Final paid or payable order total"
        },
        "currency": {
          "type": "string",
          "description": "ISO currency code (e.g. USD)",
          "maxLength": 10
        },
        "paymentMethod": {
          "type": "string",
          "description": "Selected payment method or gateway channel",
          "maxLength": 64
        },
        "paymentStatus": {
          "type": "string",
          "description": "Payment transaction status",
          "enum": ["Pending", "Paid", "Failed", "Refunded"],
          "maxLength": 32
        },
        "orderStatus": {
          "type": "string",
          "description": "Order fulfillment pipeline status",
          "enum": ["Pending", "Confirmed", "Processing", "Shipped", "Delivered", "Cancelled"],
          "maxLength": 32
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp when the order was placed"
        },
        "paymentId": {
          "type": "string",
          "description": "Payment transaction identifier",
          "maxLength": 128
        },
        "transactionReference": {
          "type": "string",
          "description": "Zelle confirmation or transaction reference code",
          "maxLength": 128
        },
        "id": {
          "type": "string",
          "description": "Unique order identifier alias",
          "maxLength": 64
        },
        "userId": {
          "type": "string",
          "description": "UID of the user placing the order",
          "maxLength": 128
        },
        "date": {
          "type": "string",
          "description": "Human-readable order date",
          "maxLength": 64
        },
        "status": {
          "type": "string",
          "description": "Order fulfillment status alias",
          "enum": ["Pending", "Confirmed", "Processing", "Shipped", "Delivered", "Cancelled"],
          "maxLength": 32
        },
        "trackingNumber": {
          "type": "string",
          "description": "Shipping carrier tracking number",
          "maxLength": 64
        },
        "carrier": {
          "type": "string",
          "description": "Delivery logistics carrier",
          "maxLength": 64
        },
        "estimatedDelivery": {
          "type": "string",
          "description": "Estimated delivery window",
          "maxLength": 64
        },
        "subtotal": {
          "type": "number",
          "description": "Items subtotal before shipping and discounts"
        },
        "shipping": {
          "type": "number",
          "description": "Calculated shipping charge"
        },
        "discount": {
          "type": "number",
          "description": "Applied discount dollar amount"
        },
        "tax": {
          "type": "number",
          "description": "Calculated tax charge"
        },
        "total": {
          "type": "number",
          "description": "Total final amount"
        }
      },
      "required": ["orderId", "customerName", "customerEmail", "totalAmount", "paymentStatus", "orderStatus"]
    },
    "WishlistItem": {
      "title": "WishlistItem",
      "description": "Saved product in user's wishlist",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Product identifier or wishlist document ID",
          "maxLength": 64
        },
        "productId": {
          "type": "string",
          "description": "Product ID referenced from the catalog",
          "maxLength": 64
        },
        "addedAt": {
          "type": "string",
          "description": "Timestamp when saved to wishlist"
        }
      },
      "required": ["id", "productId"]
    },
    "Inquiry": {
      "title": "Inquiry",
      "description": "Client concierge inquiry or message",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Inquiry identifier",
          "maxLength": 64
        },
        "name": {
          "type": "string",
          "description": "Client name",
          "maxLength": 100
        },
        "email": {
          "type": "string",
          "description": "Client contact email",
          "maxLength": 120
        },
        "subject": {
          "type": "string",
          "description": "Inquiry subject line",
          "maxLength": 150
        },
        "message": {
          "type": "string",
          "description": "Message body",
          "maxLength": 2000
        },
        "createdAt": {
          "type": "string",
          "description": "Creation timestamp"
        }
      },
      "required": ["name", "email", "message"]
    },
    "ShippingAddress": {
      "title": "ShippingAddress",
      "description": "Customer delivery address",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Address identifier",
          "maxLength": 64
        },
        "title": {
          "type": "string",
          "description": "Address nickname or label (e.g. Home, Office)",
          "maxLength": 64
        },
        "street": {
          "type": "string",
          "description": "Street address and unit/apt",
          "maxLength": 150
        },
        "city": {
          "type": "string",
          "description": "City name",
          "maxLength": 100
        },
        "state": {
          "type": "string",
          "description": "State or province",
          "maxLength": 50
        },
        "zip": {
          "type": "string",
          "description": "Postal or ZIP code",
          "maxLength": 20
        },
        "isDefault": {
          "type": "boolean",
          "description": "Whether this address is the customer's primary address"
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp when the address was added"
        },
        "updatedAt": {
          "type": "string",
          "description": "Timestamp when the address was last modified"
        }
      },
      "required": ["id", "street", "city", "state", "zip"]
    },
    "Category": {
      "title": "Category",
      "description": "Apparel and accessories catalog category",
      "type": "object",
      "properties": {
        "categoryId": {
          "type": "string",
          "description": "Unique category identifier",
          "maxLength": 64
        },
        "nameEn": {
          "type": "string",
          "description": "Category name in English",
          "maxLength": 100
        },
        "nameBn": {
          "type": "string",
          "description": "Category name in Bengali",
          "maxLength": 100
        },
        "image": {
          "type": "string",
          "description": "Featured photography URL for the category",
          "maxLength": 500
        },
        "slug": {
          "type": "string",
          "description": "URL-safe slug",
          "maxLength": 100
        },
        "status": {
          "type": "string",
          "description": "Category visibility status",
          "maxLength": 32
        },
        "createdAt": {
          "type": "string",
          "description": "Creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "description": "Last update timestamp"
        }
      },
      "required": ["nameEn", "slug"]
    },
    "Review": {
      "title": "Review",
      "description": "Client product review and evaluation",
      "type": "object",
      "properties": {
        "reviewId": {
          "type": "string",
          "description": "Unique review identifier",
          "maxLength": 64
        },
        "productId": {
          "type": "string",
          "description": "Target product identifier",
          "maxLength": 64
        },
        "customerId": {
          "type": "string",
          "description": "UID of the reviewing client",
          "maxLength": 128
        },
        "customerName": {
          "type": "string",
          "description": "Name of the reviewer",
          "maxLength": 100
        },
        "rating": {
          "type": "number",
          "description": "Numerical rating (1-5)"
        },
        "comment": {
          "type": "string",
          "description": "Written review text",
          "maxLength": 3000
        },
        "status": {
          "type": "string",
          "description": "Moderation status (approved, pending, rejected)",
          "maxLength": 32
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp when posted"
        }
      },
      "required": ["productId", "customerName", "rating", "comment"]
    },
    "CartItem": {
      "title": "CartItem",
      "description": "Shopping bag item saved for customer session",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique item configuration identifier",
          "maxLength": 128
        },
        "productId": {
          "type": "string",
          "description": "ID of product",
          "maxLength": 64
        },
        "quantity": {
          "type": "number",
          "description": "Quantity in bag"
        },
        "selectedSize": {
          "type": "string",
          "description": "Selected size variant",
          "maxLength": 64
        },
        "selectedColor": {
          "type": "string",
          "description": "Selected color variant",
          "maxLength": 64
        }
      },
      "required": ["id", "productId", "quantity"]
    },
    "ZelleSettings": {
      "title": "ZelleSettings",
      "description": "Store Zelle payment recipient configuration managed by administrator",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "description": "Zelle registered email address",
          "maxLength": 120
        },
        "phone": {
          "type": "string",
          "description": "Zelle registered phone number",
          "maxLength": 30
        },
        "accountHolderName": {
          "type": "string",
          "description": "Name of the Zelle account holder",
          "maxLength": 100
        },
        "paymentInstructions": {
          "type": "string",
          "description": "Instructions for sending payment",
          "maxLength": 2000
        },
        "updatedAt": {
          "type": "string",
          "description": "Timestamp when settings were last modified"
        }
      },
      "required": ["email", "accountHolderName"]
    }
  },
  "firestore": {
    "/settings/{settingId}": {
      "schema": "ZelleSettings",
      "description": "Store configuration documents including Zelle payment settings"
    },
    "/products/{productId}": {
      "schema": "Product",
      "description": "Modest apparel and accessory products catalog"
    },
    "/categories/{categoryId}": {
      "schema": "Category",
      "description": "Catalog categories with bilingual metadata"
    },
    "/reviews/{reviewId}": {
      "schema": "Review",
      "description": "Verified client product reviews and ratings"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Store orders collection accessible and manageable by authorized store administrators"
    },
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile data accessible by the authenticated user"
    },
    "/users/{userId}/orders/{orderId}": {
      "schema": "Order",
      "description": "Orders placed by the authenticated user"
    },
    "/users/{userId}/wishlist/{productId}": {
      "schema": "WishlistItem",
      "description": "Saved wishlist items for the authenticated user"
    },
    "/users/{userId}/cart/{itemId}": {
      "schema": "CartItem",
      "description": "Saved persistent shopping bag items for authenticated user"
    },
    "/users/{userId}/addresses/{addressId}": {
      "schema": "ShippingAddress",
      "description": "Customer delivery addresses managed by the authenticated user"
    },
    "/inquiries/{inquiryId}": {
      "schema": "Inquiry",
      "description": "Client inquiries submitted to concierge"
    }
  }
}
