# Protect config and private files from direct web access
<FilesMatch "^(config\.php|config\.local\.php|config\.env\.php|\.env|schema\.sql)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
